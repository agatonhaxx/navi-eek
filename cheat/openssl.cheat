; Cryptography toolkit.
; More information: https://www.openssl.org/docs/manmaster/man1/openssl/

% openssl

# View certificate details
openssl x509 -in <cert> -text -noout

% openssl

# View certificate from a server
openssl s_client -connect <host>:<port> -servername <host> </dev/null 2>/dev/null | openssl x509 -text

% openssl

# Generate a self-signed certificate
openssl req -x509 -newkey rsa:4096 -keyout <key> -out <cert> -days <days> -nodes

% openssl

# Generate a private key
openssl genrsa -out <key> <bits>

% openssl

# Compute a file hash
openssl dgst -sha256 <file>

% openssl

# Base64 encode
openssl base64 -in <file>

% openssl

# Check TLS version support
openssl s_client -connect <host>:<port> -tls1_2
