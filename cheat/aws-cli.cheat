; AWS command-line interface.
; More information: https://aws.amazon.com/cli/

% aws

# Configure credentials
aws configure

% aws

# List S3 buckets
aws s3 ls

% aws

# Sync a directory to S3 (delete removed files)
aws s3 sync <dir> s3://<bucket>/<prefix> --delete

% aws

# List EC2 instances with id/state/type
aws ec2 describe-instances --query 'Reservations[*].Instances[*].[InstanceId,State.Name,InstanceType]'

% aws

# Get caller identity
aws sts get-caller-identity

% aws

# List Lambda functions
aws lambda list-functions

% aws

# Describe a CloudFormation stack
aws cloudformation describe-stacks --stack-name <name>

% aws

# List IAM users
aws iam list-users

% aws

# List IAM roles
aws iam list-roles

% aws

# List customer-managed policies
aws iam list-policies --scope Local

% aws

# Assume an IAM role
aws sts assume-role --role-arn "arn:aws:iam::<account-id>:role/<role-name>" --role-session-name "<session-name>"

% aws

# Launch an EC2 instance
aws ec2 run-instances --image-id <ami-id> --instance-type t3.micro --key-name <key-pair> --security-group-ids <sg-id>

% aws

# Terminate an instance
aws ec2 terminate-instances --instance-ids <instance-id>

% aws

# Copy a file to S3
aws s3 cp <file> s3://<bucket>/<key>

% aws

# Generate a presigned URL (temporary access)
aws s3 presign s3://<bucket>/<key> --expires-in 3600

% aws

# Set S3 bucket lifecycle configuration
aws s3api put-bucket-lifecycle-configuration --bucket <bucket> --lifecycle-configuration file://lifecycle.json

% aws

# Create a DynamoDB table (pay-per-request)
aws dynamodb create-table --table-name <table> --attribute-definitions AttributeName=id,AttributeType=S --key-schema AttributeName=id,KeyType=HASH --billing-mode PAY_PER_REQUEST

% aws

# Put an item into a DynamoDB table
aws dynamodb put-item --table-name <table> --item '{"id": {"S": "<value>"}, "data": {"S": "hello"}}'

% aws

# Query DynamoDB by partition key
aws dynamodb query --table-name <table> --key-condition-expression "id = :id" --expression-attribute-values '{":id":{"S":"<value>"}}'

% aws

# Tag an EC2 instance
aws ec2 create-tags --resources <instance-id> --tags Key=Environment,Value=prod Key=Project,Value=<project>

% aws

# List EC2 service quotas
aws service-quotas list-service-quotas --service-code ec2

% aws

# Request a quota increase
aws support create-case --subject "Request limit increase for <service>"
