; Linux kernel introspection: /proc and /sys files, modules, signals, memory, cgroups, namespaces, tracing.

% cat

# Show CPU details
cat /proc/cpuinfo

% cat

# Show memory information
cat /proc/meminfo

% cat

# Show 1, 5, and 15 minute load averages
cat /proc/loadavg

% cat

# Show the kernel version
cat /proc/version

% cat

# Show the maximum PID
cat /proc/sys/kernel/pid_max

% cat

# Show whether IP forwarding is enabled (0/1)
cat /proc/sys/net/ipv4/ip_forward

% cat

# List supported filesystems
cat /proc/filesystems

% cat

# Show mounted filesystems
cat /proc/mounts

% cat

# Show the CPU frequency scaling governor of CPU 0
cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

% cat

# Show the detailed memory map of a process
cat /proc/<pid>/smaps

% cat

# Show the OOM killer score of a process
cat /proc/<pid>/oom_score

% cat

# Show the I/O scheduler of a disk
cat /sys/block/<disk>/queue/scheduler

% cat

# List the PIDs in a cgroup
cat /sys/fs/cgroup/<group>/cgroup.procs

% ls

# List network interfaces
ls /sys/class/net/

% ls

# List block devices
ls /sys/block/

% ls

# Show the cgroup tree (cgroups v2)
ls /sys/fs/cgroup/

% ls

# Show the namespaces of a process
ls -l /proc/<pid>/ns/

% lsmod

# List loaded kernel modules
lsmod

% modinfo

# Show kernel module details
modinfo <module>

% modprobe

# Load a kernel module (with its dependencies)
modprobe <module>

% modprobe

# Remove a kernel module
modprobe -r <module>

% kill

# List signals
kill -l

% kill

# Send a signal to a process
kill -<signal> <pid>

% free

# Show a memory usage overview
free -h

% strace

# Trace the syscalls of a running process
strace -p <pid>

% strace

# Run a command and summarize its syscalls
strace -c <command>

% perf

# Live CPU sampling
perf top

% perf

# Record a profile, then analyze it
perf record <command> && perf report

% bpftrace

# Trace file opens by filename (tracepoint one-liner)
bpftrace -e 'tracepoint:syscalls:sys_enter_openat { printf("%s\n", str(args->filename)); }'

% lsns

# List namespaces
lsns
