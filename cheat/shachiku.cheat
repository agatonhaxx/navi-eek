% shachiku

# Generate cover letter
shachiku cover-letter <job_id>

% shachiku

# Send digest email
shachiku digest

% shachiku

# Resume a failed application
shachiku resume <app_id>

% shachiku

# Brute-force login (password testing)
shachiku brute <broker_url>
