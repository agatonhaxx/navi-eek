; Transfer data from or to a server.
; More information: https://curl.se/docs/manpage.html
; Merged from curl.cheat + network__curl community cheats.

% curl

# GET request
curl <url>

% curl

# GET with custom headers
curl -H "<header>" <url>

$ header: printf '%s\n' 'Content-Type: application/json'

% curl

# Request with a custom header
curl -X <method> <url> -H "<headername>: <headervalue>"

% curl

# POST JSON data
curl -X POST -H "Content-Type: application/json" -d '<json>' <url>

$ json: printf '%s\n' '{"key":"value"}'

% curl

# POST form data
curl -X POST -d "<field1>" -d "<field2>" <url>

$ field1: printf '%s\n' 'key1=value1'

$ field2: printf '%s\n' 'key2=value2'

% curl

# Request with a form body
curl <url> -d <bodykey>=<bodyvalue>

% curl

# Request with a body from a file
curl -X <method> <url> --data-binary "@<file>"

% curl

# Follow redirects
curl -L <url>

% curl

# Save output to file
curl -o <file> <url>

% curl

# Include response headers
curl -i <url>

% curl

# Send via specific HTTP method
curl -X <method> <url>

% curl

# Exit with a non-zero status code on failure
curl --fail <url>

% curl

# Send an authenticated request
curl -u <username>:<password> -X <method> <url>

% curl

# Silent mode (no progress bar)
curl -s <url>

% curl

# Verbose output for debugging
curl -v <url>

$ method: printf '%s\n' 'GET' 'POST' 'PUT' 'DELETE' 'PATCH'
$ file: ls
